 \"number\":\n        ok = isinstance(v, (int, float)) and not isinstance(v, bool) and lo <= v <= hi\n    elif kind == \"string\":\n        ok = isinstance(v, str) and v.strip() != \"\"\n    else:  # list of length lo\n        ok = isinstance(v, list) and len(v) == lo\n    print(f\"CHECK {key}: {'PASS' if ok else 'FAIL'}\")\n    fails += not ok\nsys.exit(1 if fails else 0)\n", "inputs/readings.csv": "sensor,ts,raw_c\ns-04,2026-10-15T00:00,19.98\ns-02,2026-10-15T00:06,19.63\ns-02,2026-10-15T00:12,19.1\ns-01,2026-10-15T00:18,18.16\ns-03,2026-10-15T00:24,23.58\ns-03,2026-10-15T00:30,20.85\ns-04,2026-10-15T00:36,19.23\ns-01,2026-10-15T00:42,21.75\ns-02,2026-10-15T00:48,23.35\ns-02,2026-10-15T00:54,21.09\ns-04,2026-10-15T01:00,25.09\ns-01,2026-10-15T01:06,20.68\ns-04,2026-10-15T01:12,18.36\ns-03,2026-10-15T01:18,18.86\ns-01,2026-10-15T01:24,20.27\ns-01,2026-10-15T01:30,21.83\ns-03,2026-10-15T01:36,19.4\ns-02,2026-10-15T01:42,21.68\ns-02,2026-10-15T01:48,25.62\ns-01,2026-10-15T01:54,22.98\ns-04,2026-10-15T02:00,20.44\ns-03,2026-10-15T02:06,23.56\ns-02,2026-10-15T02:12,19.31\ns-01,2026-10-15T02:18,20.04\ns-04,2026-10-15T02:24,17.51\ns-03,2026-10-15T02:30,21.23\ns-04,2026-10-15T02:36,19.59\ns-04,2026-10-15T02:42,21.35\ns-04,2026-10-15T02:48,22.71\ns-03,2026-10-15T02:54,22.97\ns-03,2026-10-15T03:00,21.3\ns-04,2026-10-15T03:06,22.75\ns-02,2026-10-15T03:12,21.03\ns-02,2026-10-15T03:18,17.73\ns-02,2026-10-15T03:24,18.2\ns-01,2026-10-15T03:30,20.1\ns-03,2026-10-15T03:36,22.69\ns-02,2026-10-15T03:42,23.0\ns-02,2026-10-15T03:48,19.48\ns-01,2026-10-15T03:54,21.55\ns-03,2026-10-15T04:00,14.76\ns-01,2026-10-15T04:06,18.29\ns-02,2026-10-15T04:12,20.31\ns-04,2026-10-15T04:18,18.86\ns-03,2026-10-15T04:24,20.9\ns-01,2026-10-15T04:30,20.47\ns-03,2026-10-15T04:36,22.14\ns-02,2026-10-15T04:42,22.03\ns-03,2026-10-15T04:48,19.88\ns-02,2026-10-15T04:54,19.01\ns-04,2026-10-15T05:00,23.59\ns-03,2026-10-15T05:06,22.86\ns-02,2026-10-15T05:12,20.45\ns-04,2026-10-15T05:18,21.1\ns-02,2026-10-15T05:24