 json\nimport os\nimport sys\n\nINPUTS = ['inputs/meter.db', 'inputs/tariffs.csv']\nKEYS = {'total_kwh_sep': ['number', 0, 1000000.0], 'bill_sep': ['number', 0, 1000000.0]}\n\nfails = 0\nfor p in INPUTS:\n    ok = os.path.exists(p)\n    print(f\"CHECK input:{p}: {'PASS' if ok else 'FAIL (missing)'}\")\n    fails += not ok\ntry:\n    with open(\"answer.json\") as f:\n        ans = json.load(f)\nexcept (OSError, ValueError) as e:\n    print(f\"CHECK answer.json: FAIL ({e})\")\n    sys.exit(1)\nfor key, (kind, lo, hi) in KEYS.items():\n    v = ans.get(key)\n    if kind == \"number\":\n        ok = isinstance(v, (int, float)) and not isinstance(v, bool) and lo <= v <= hi\n    elif kind == \"string\":\n        ok = isinstance(v, str) and v.strip() != \"\"\n    else:  # list of length lo\n        ok = isinstance(v, list) and len(v) == lo\n    print(f\"CHECK {key}: {'PASS' if ok else 'FAIL'}\")\n    fails += not ok\nsys.exit(1 if fails else 0)\n", "inputs/meter.db": "b64:", "inputs/tariffs.csv": "month,usd_per_kwh\n2026-08,0.231\n2026-09,0.247\n2026-10,0.252\n"}, "wall_seconds": 29.69, "claims": null}}
